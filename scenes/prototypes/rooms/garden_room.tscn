[sub_resource type="GDScript" id="GDScript_jslgg"]
script/source = "extends Area2D

@onready var floating_text: Label = $CanvasLayer/FloatingText
@onready var interact_indicator: Label = $CanvasLayer/InteractIndicator
@onready var dialogue_box: PanelContainer = $CanvasLayer/DialogueBox
@onready var dialogue_text: RichTextLabel = $CanvasLayer/DialogueBox/Control/MarginContainer/DialogueText
@onready var option_btn1: Button = $CanvasLayer/DialogueBox/Control/OptionsContainer/OptionButton1
@onready var option_btn2: Button = $CanvasLayer/DialogueBox/Control/OptionsContainer/OptionButton2

var player_in_range: bool = false
var dialogue_active: bool = false

@export var new_text: String = \"What a strange flower...\"
@export var new_text2: String = \"\"
@export var wait_time: float = 0.04
@export var start_delay: float = 0.15
@export var indicator_offset_y: float = -130  # ✅ Distance ABOVE flower — adjust if needed

var is_typing: bool = false
var text_shown: bool = false
var has_seen_text: bool = false

func _ready() -> void:
	floating_text.visible = false
	floating_text.text = \"\"
	interact_indicator.visible = false
	interact_indicator.text = \"Interact [E]\"
	dialogue_box.visible = false
	
	# ✅ Debug outputs — exactly as requested
	print(\"FloatingText Node Exists: \", floating_text != null, \" | Visible: \", floating_text.visible)
	print(\"InteractIndicator Node Exists: \", interact_indicator != null, \" | Visible: \", interact_indicator.visible)
	print(\"DialogueBox Node Exists: \", dialogue_box != null, \" | Visible: \", dialogue_box.visible)
	print(\"DialogueText: \", dialogue_text != null)
	print(\"OptionBtn1: \", option_btn1 != null)
	print(\"OptionBtn2: \", option_btn2 != null)
	
	body_entered.connect(_on_body_entered)
	body_exited.connect(_on_body_exited)
	
	if option_btn1:
		option_btn1.pressed.connect(_close_dialogue)
		print(\"✅ Button1 connected\")
	if option_btn2:
		option_btn2.pressed.connect(_close_dialogue)
		print(\"✅ Button2 connected\")

func _process(_delta: float) -> void:
	var player = _get_player()
	if not player:
		return
	
	# ✅ Show/hide indicator ABOVE THIS FLOWER (Area2D global position)
	if player_in_range and not dialogue_active:
		interact_indicator.visible = true
		_position_indicator_above_flower()
	else:
		interact_indicator.visible = false
	
	# Floating text above player — only first time
	if player_in_range and not dialogue_active:
		if not has_seen_text:
			_update_floating_text_position(player)
			floating_text.visible = true
			
			if not text_shown and not is_typing:
				_start_typing()
		else:
			floating_text.visible = false
		
		# Interact ANYTIME
		if Input.is_action_just_pressed(\"interact\"):
			_open_dialogue()
	else:
		floating_text.visible = false

func _position_indicator_above_flower() -> void:
	# ✅ Places indicator DIRECTLY above this flower's center point
	var viewport = get_viewport()
	var flower_screen_pos = viewport.get_canvas_transform() * global_position
	
	interact_indicator.global_position = flower_screen_pos - Vector2(interact_indicator.size.x / 2, -indicator_offset_y)
	interact_indicator.z_index = 150  # Visible above most things, below floating text if needed

func _get_player() -> Node2D:
	return get_tree().get_first_node_in_group(\"player\")

func _on_body_entered(body: Node2D) -> void:
	var player = _get_player()
	if player and body == player:
		player_in_range = true
		if not has_seen_text:
			text_shown = false

func _on_body_exited(body: Node2D) -> void:
	var player = _get_player()
	if player and body == player:
		player_in_range = false
		is_typing = false
		floating_text.visible = false
		interact_indicator.visible = false
		floating_text.text = \"\"
		if dialogue_active:
			_close_dialogue()

func _type_out(line: String) -> void:
	floating_text.text = \"\"
	if start_delay > 0:
		await get_tree().create_timer(start_delay).timeout
	for char in line:
		if not is_typing:
			return
		floating_text.text += char
		await get_tree().create_timer(wait_time).timeout

func _start_typing() -> void:
	text_shown = true
	is_typing = true
	floating_text.text = \"\"
	
	await _type_out(new_text)
	if new_text2 != \"\":
		await _type_out(new_text2)
	
	is_typing = false

func _update_floating_text_position(player: Node2D) -> void:
	if not floating_text:
		return
	
	var viewport = get_viewport()
	var player_screen_pos = viewport.get_canvas_transform() * player.global_position
	
	var text_x = player_screen_pos.x - floating_text.size.x / 2
	var text_y = player_screen_pos.y - 110
	
	floating_text.position = Vector2(text_x, text_y)
	floating_text.z_index = 100

func _open_dialogue() -> void:
	if not dialogue_text:
		print(\"❌ DialogueText is NULL — check node path!\")
		return
	
	dialogue_active = true
	is_typing = false
	interact_indicator.visible = false
	
	if not has_seen_text:
		has_seen_text = true
		print(\"✅ First interaction — text won't show again\")
	
	floating_text.visible = false
	dialogue_box.visible = true
	dialogue_text.text = \"???: If I color-code these case studies tonight, I'll catch up; I'm not falling behind, I'm just adjusting.\"
	print(\"✅ Dialogue opened\")

func _close_dialogue() -> void:
	dialogue_active = false
	if dialogue_box:
		dialogue_box.visible = false
		print(\"✅ DialogueBox closed — can interact again\")
	else:
		print(\"❌ dialogue_box is null!\")
	floating_text.visible = false
	# Indicator reappears automatically if still in range
"

