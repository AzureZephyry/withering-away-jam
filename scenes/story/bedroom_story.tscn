[gd_scene format=3]

[ext_resource type="PackedScene" path="res://scenes/prototypes/camera_lab.tscn" id="1_room"]
[ext_resource type="Script" path="res://scripts/bedroom_intro.gd" id="2_intro"]
[ext_resource type="PackedScene" path="res://scenes/UI/dialogue_panel.tscn" id="3_dialogue"]
[ext_resource type="PackedScene" path="res://scenes/UI/phone_conversation.tscn" id="4_phone"]
[ext_resource type="FontFile" path="res://assets/fonts/Pixel handwriting_regular.ttf" id="5_font"]
[ext_resource type="PackedScene" path="res://scenes/UI/bedroom_scene02_overlay.tscn" id="6_scene02"]

[node name="BedroomStory" type="Node2D"]
texture_filter = 1
script = ExtResource("2_intro")

[node name="Laboratory" parent="." instance=ExtResource("1_room")]

[node name="StoryLayer" type="CanvasLayer" parent="."]
layer = 4

[node name="DialoguePanel" parent="StoryLayer" instance=ExtResource("3_dialogue")]
visible = false
texture_filter = 1
world = 1
speaker_name = "Albert"

[node name="PhoneConversation" parent="StoryLayer" instance=ExtResource("4_phone")]
visible = false

[node name="Clock" type="Label" parent="StoryLayer"]
anchor_left = 0.2
anchor_top = 0.1
anchor_right = 0.8
anchor_bottom = 0.25
mouse_filter = 2
theme_override_fonts/font = ExtResource("5_font")
theme_override_font_sizes/font_size = 72
theme_override_colors/font_color = Color(0.94, 0.93, 0.88, 1)
text = "6:30 AM"
horizontal_alignment = 1
vertical_alignment = 1

[node name="ArrivalFade" type="ColorRect" parent="StoryLayer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
color = Color(0, 0, 0, 1)

[node name="Scene02" parent="." instance=ExtResource("6_scene02")]

[connection signal="finished" from="StoryLayer/PhoneConversation" to="." method="_on_phone_finished"]
[connection signal="choice_committed" from="StoryLayer/PhoneConversation" to="." method="_on_phone_choice_committed"]
